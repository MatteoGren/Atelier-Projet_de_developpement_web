{

  "require" : {
    "php": ">=8.5",
    "slim/slim": "^4.15",
    "slim/psr7": "^1.7",
    "ramsey/uuid": "^4.7",
    "firebase/php-jwt": "^7.0",
    "monolog/monolog": "^3.7",
    "fakerphp/faker":"^1.23",
    "php-di/php-di": "^7.0",
    "php-di/slim-bridge": "^3.4",
    "respect/validation": "^3.0",
    "zircote/swagger-php": "^4.11.0",
    "ext-pdo": "*",
    "vlucas/phpdotenv": "^5.5"
  },
  "require-dev": {
    "phpunit/phpunit": "^12.5",
    "pestphp/pest": "^4.7",
    "spatie/phpunit-watcher": "^1.24"
  },
  "autoload": {
    "psr-4" : {
      "toubilib\\" : "./src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "tests\\": "tests/"
    }
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  }
}
